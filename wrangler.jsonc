{
  "name": "holomatrix",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/landing", "/signup", "/tabs", "/news/*", "/research/*", "/about/*", "/clients/*", "/funds/*", "/contact/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview",
    "GROQ_MODEL": "llama-3.3-70b-versatile,llama-3.1-8b-instant",
    "OPENROUTER_MODEL": "openrouter/free,openai/gpt-oss-120b:free,google/gemma-4-31b-it:free",
    "CF_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct,@cf/meta/llama-3.1-8b-instruct-fp8",
    "MISTRAL_MODEL": "mistral-small-latest",
    "CEREBRAS_MODEL": "gpt-oss-120b"
  },
  "observability": { "enabled": true }
}
